# See docs/env.md for every variable.
NODE_ENV=development
DATABASE_URL=postgres://wishlist:wishlist@localhost:5432/wishlist
REDIS_URL=redis://localhost:6379/0

BOT_TOKEN=123456:replace-with-botfather-token-xxxxxxxxxxxx
BOT_USERNAME=my_wishlist_bot
MINI_APP_SHORT_NAME=app
MINI_APP_URL=https://localhost:5173
BOT_MODE=polling
# WEBHOOK_PUBLIC_URL=https://bot.example.com
# WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
# SUPPORT_CHAT_ID=

CORS_ORIGINS=https://localhost:5173
STARS_RATES=USD:1.3,EUR:1.2

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wishlist
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/wishlist
