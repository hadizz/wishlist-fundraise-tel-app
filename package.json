{
  "name": "wishlist-fundraise-tel-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "bun --watch src/api/server.ts",
    "dev:bot": "BOT_MODE=polling bun --watch src/bot/index.ts",
    "start:api": "bun src/api/server.ts",
    "start:bot": "bun src/bot/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "superjson": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0"
  }
}
